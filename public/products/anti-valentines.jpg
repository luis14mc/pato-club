<svg width="800" height="1067" xmlns="http://www.w3.org/2000/svg">
  <!-- Fondo elegante gris suave -->
  <defs>
    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f5f5f5;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#e8e8e8;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="1067" fill="url(#grad1)"/>
  
  <!-- Círculo decorativo sutil -->
  <circle cx="400" cy="533" r="180" fill="#dcdcdc" opacity="0.3"/>
  
  <!-- Texto minimalista -->
  <text x="400" y="500" font-family="Arial, sans-serif" font-size="32" font-weight="300" fill="#1a1a1a" text-anchor="middle" letter-spacing="3">PATO CLUB</text>
  <text x="400" y="570" font-family="Arial, sans-serif" font-size="18" fill="#666666" text-anchor="middle" letter-spacing="1">anti-valentines</text>
</svg>
